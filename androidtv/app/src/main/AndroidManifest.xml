<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- App TV pilotee au clavier/telecommande, pas besoin d'ecran tactile -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:logo="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.BellODuLacTV"
        android:usesCleartextTraffic="false">

        <!-- banner/icon repetes ici (en plus du tag application ci-dessus) : sur certaines
             versions du lanceur Google TV, seule l'activite portant l'intent LEANBACK_LAUNCHER
             est consultee ; si elle n'a pas sa propre banniere, le lanceur l'ignore et affiche
             une tuile noire generee avec juste l'icone au milieu. (roundIcon/logo ne sont pas
             des attributs valides sur activity, uniquement sur application ; aapt2 rejette
             le build s'ils y sont ajoutes.) -->
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/banner"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BellODuLacTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Uniquement LEANBACK_LAUNCHER : app 100% TV (voir doc officielle
                     developer.android.com/training/tv/get-started/create). Ajouter LAUNCHER
                     en plus est reserve au cas "instant experience" / app hybride mobile+TV,
                     et peut faire traiter l'app comme mobile par certains lanceurs Google TV. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
